# .env.example
# -----------------------------------------------------------------------------
# Copiez ces variables dans Vercel > Project Settings > Environment Variables.
# Ne mettez JAMAIS les vraies valeurs dans un fichier .env commité sur Git.
# -----------------------------------------------------------------------------

# --- Base de données Supabase ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé "service_role" (Project Settings > API sur Supabase) — jamais la clé "anon"
SUPABASE_SERVICE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Authentification Admin ---
ADMIN_EMAIL=admin@belrosewally.com
# Générez ce hash avec : node scripts/hash-password.js "VotreMotDePasse"
ADMIN_PASSWORD_HASH=$2a$10$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Chaîne aléatoire longue et secrète (ex: générée avec `openssl rand -hex 32`)
JWT_SECRET=remplacez_par_une_chaine_aleatoire_longue_et_secrete

# --- Notifications e-mail (Resend — https://resend.com) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_NOTIFICATION_EMAIL=commandes@belrosewally.com
NOTIFICATION_SENDER_EMAIL=commandes@belrosewally.com

# --- Notifications SMS (Twilio — optionnel) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+15005550006
ADMIN_NOTIFICATION_PHONE=+24177000000
